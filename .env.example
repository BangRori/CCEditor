# NVIDIA NVI API — прямой режим (только для локальной разработки).
# ВАЖНО: не добавляйте ключ в GitHub Secrets для сборки сайта —
# бандл GitHub Pages публичный, ключ утечёт.
# Для продакшена используйте Cloudflare Worker (см. TRANSLATE_SETUP.md).
# VITE_NVIDIA_API_KEY=nvapi-...

# URL прокси-воркера. Если не задан, используется встроенный дефолт
# (см. DEFAULT_PROXY в src/components/TranslateButton.tsx).
# VITE_TRANSLATE_PROXY_URL=https://cc-editor-translate.roxroot.workers.dev
