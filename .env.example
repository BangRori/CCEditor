# NVIDIA NVI API — прямой запрос (только для локальной разработки).
# ВАЖНО: не ставьте этот ключ в GitHub Secrets! Он будет в публичном бандле сайта.
# VITE_NVIDIA_API_KEY=nvapi-...

# URL прокси-воркера (по умолчанию встроен, override можно через localStorage.translate_proxy_url)
# VITE_TRANSLATE_PROXY_URL=https://cc-editor-translate.<sub>.workers.dev

# КЛЮЧ ДОСТУПА К ВОРКЕРУ (48 символов, hex).
# Берётся на сайте NVIDIA (в личном кабинете → API Keys) — это тот же ключ, что используете
# для прямого доступа к https://integrate.api.nvidia.com/v1/chat/completions .
# Пример: openssl rand -hex 24
# VITE_TRANSLATE_CLIENT_KEY=af5c1c4046c2ac6fe1ea2ae5c0dcf15178d078d6f3a1b5e